  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "20.14.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.19",
    "lefthook": "2.2.2",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.4",
    "typescript": "5.9.3",
    "wrangler": "4.155.0"
  },
  "packageManager": "pnpm@12.11.2"
