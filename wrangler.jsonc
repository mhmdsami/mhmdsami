{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mhmdsami",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "routes": [{ "pattern": "sam1.space", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
